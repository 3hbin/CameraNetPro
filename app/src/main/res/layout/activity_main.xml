<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/grid_overlay"
        android:visibility="visible" />

    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="96sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:visibility="gone"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="8"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- AI Mode indicator -->
    <TextView
        android:id="@+id/tvAIMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Auto"
        android:textColor="#00E5FF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="#99000000"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:layout_marginTop="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate"
            android:tint="#FFFFFF"
            android:contentDescription="Đổi camera" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="#FFFFFF"
            android:contentDescription="Cài đặt" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/tvMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ảnh"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="#66000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="6dp" />

        <ImageButton
            android:id="@+id/btnTimer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_recent_history"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnGrid"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_view"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTimerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Timer: Tắt"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#66000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter: Thường"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#66000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvRatio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tỷ lệ: 4:3"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#66000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvZoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0x"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="#66000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:layout_marginBottom="8dp" />

        <!-- AI Modes scroll -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/aiModesRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:gravity="center_vertical">

                <TextView android:id="@+id/btnAIAuto" android:layout_width="wrap_content" android:layout_height="34dp" android:text="AI Auto" android:textColor="#00E5FF" android:textSize="12sp" android:textStyle="bold" android:gravity="center" android:paddingHorizontal="12dp" android:background="#55FFFFFF" android:layout_marginEnd="6dp" />
                <TextView android:id="@+id/btnBeauty" android:layout_width="wrap_content" android:layout_height="34dp" android:text="Làm đẹp" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:paddingHorizontal="12dp" android:background="#55FFFFFF" android:layout_marginEnd="6dp" />
                <TextView android:id="@+id/btnPortrait" android:layout_width="wrap_content" android:layout_height="34dp" android:text="Chân dung" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:paddingHorizontal="12dp" android:background="#55FFFFFF" android:layout_marginEnd="6dp" />
                <TextView android:id="@+id/btnNight" android:layout_width="wrap_content" android:layout_height="34dp" android:text="Đêm" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:paddingHorizontal="12dp" android:background="#55FFFFFF" android:layout_marginEnd="6dp" />
                <TextView android:id="@+id/btnFood" android:layout_width="wrap_content" android:layout_height="34dp" android:text="Đồ ăn" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:paddingHorizontal="12dp" android:background="#55FFFFFF" android:layout_marginEnd="6dp" />
                <TextView android:id="@+id/btnLandscape" android:layout_width="wrap_content" android:layout_height="34dp" android:text="Phong cảnh" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:paddingHorizontal="12dp" android:background="#55FFFFFF" android:layout_marginEnd="6dp" />
                <TextView android:id="@+id/btnFilter" android:layout_width="wrap_content" android:layout_height="34dp" android:text="Bộ lọc" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:paddingHorizontal="12dp" android:background="#55FFFFFF" android:layout_marginEnd="6dp" />
                <TextView android:id="@+id/btnRatio" android:layout_width="wrap_content" android:layout_height="34dp" android:text="Tỷ lệ" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:paddingHorizontal="12dp" android:background="#55FFFFFF" android:layout_marginEnd="6dp" />
                <TextView android:id="@+id/btnBurst" android:layout_width="wrap_content" android:layout_height="34dp" android:text="Liên tục" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:paddingHorizontal="12dp" android:background="#55FFFFFF" android:layout_marginEnd="6dp" />
                <TextView android:id="@+id/btnSmile" android:layout_width="wrap_content" android:layout_height="34dp" android:text="Nụ cười" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:paddingHorizontal="12dp" android:background="#55FFFFFF" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnVideo"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/shutter_outer"
                android:src="@android:drawable/ic_menu_slideshow"
                android:tint="#FF5252"
                android:scaleType="centerInside"
                android:layout_marginEnd="26dp"
                android:contentDescription="Quay video" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <View android:layout_width="78dp" android:layout_height="78dp" android:background="@drawable/shutter_outer" android:layout_gravity="center" />
                <ImageButton android:id="@+id/btnCapture" android:layout_width="62dp" android:layout_height="62dp" android:layout_gravity="center" android:background="@drawable/shutter_inner" android:contentDescription="Chụp" />
            </FrameLayout>

            <View android:layout_width="50dp" android:layout_height="50dp" android:layout_marginStart="26dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/focusIndicator"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@drawable/focus_circle"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvRecording"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● REC"
        android:textColor="#FF1744"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginTop="90dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
